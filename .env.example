# Copia este archivo como .env y reemplaza los valores por los tuyos.
# Nunca subas el archivo .env real (con secretos reales) al repositorio.

# Clave secreta usada para firmar los tokens JWT.
# Genera una propia, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-for-a-real-random-value

# Algoritmo usado para firmar el JWT
ALGORITHM=HS256

# Minutos de vigencia del access token
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Orígenes permitidos por CORS, separados por coma (sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# URL de conexión a la base de datos
DATABASE_URL=sqlite:///./device_systems.db
